{
  "reproducibility": {"seed": 42},
  "runtime": {"device": "gpu", "load_tuned_if_available": true},
  "problem": {"x_bounds": [0.0, 1.0], "time_bounds": [0.0, 1.0], "true_diffusivity": 0.03},
  "inverse": {"initial_diffusivity": 0.1, "minimum_diffusivity": 1e-7, "noise_std": 0.0},
  "model": {"n_layers": 4, "n_neurons": 64, "activation": "tanh", "constraint_mode": "hard"},
  "sampling": {"interior_points": 30000, "sensor_points": 250, "boundary_points_per_edge": 250, "initial_points": 250, "validation_points": 6000, "plot_spatial_points": 150, "plot_time_points": 150},
  "loss_weights": {"pde": 1.0, "data": 1.0, "boundary": 1.0, "initial": 1.0},
  "training": {
    "optimizer": "Adam", "epochs": 100000, "learning_rate": 0.001,
    "scheduler": {"factor": 0.8, "patience": 50, "min_learning_rate": 0.00001},
    "early_stopping": {"patience": 500, "min_delta": 1e-9}, "print_every": 100
  },
  "tuning": {
    "objective": "field_plus_parameter_relative_error", "trials": 50, "epochs": 4000,
    "training_points": 1000, "sensor_points": 100, "validation_points": 2000,
    "boundary_points_per_edge": 100, "initial_points": 100,
    "n_layers": {"min": 2, "max": 5}, "n_neurons": {"min": 20, "max": 100, "step": 20},
    "scheduler": {"factor": 0.8, "patience": 50, "min_learning_rate": 0.00001},
    "early_stopping": {"patience": 500, "min_delta": 1e-9}
  },
  "output": {"tuned_hyperparameters": "pinn_hyper_tuned.json", "postprocessing_directory": "postprocessing", "show_plots": true}
}
