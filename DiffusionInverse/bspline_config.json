{
  "reproducibility": {"seed": 42},
  "runtime": {"device": "gpu", "load_tuned_if_available": true},
  "problem": {"x_bounds": [0.0, 1.0], "time_bounds": [0.0, 1.0], "true_diffusivity": 0.03},
  "inverse": {"initial_diffusivity": 0.1, "minimum_diffusivity": 1e-7, "noise_std": 0.0},
  "model": {"n_basis": 20, "degree": 3, "interior_initialization": "coons"},
  "sampling": {"interior_points": 30000, "sensor_points": 250, "initial_points": 250, "validation_points": 6000, "plot_spatial_points": 150, "plot_time_points": 150},
  "loss_weights": {"pde": 1.0, "data": 1.0},
  "training": {
    "optimizer": "Adam", "epochs": 100000, "learning_rate": 0.001,
    "scheduler": {"factor": 0.8, "patience": 50, "min_learning_rate": 0.00001},
    "early_stopping": {"patience": 500, "min_delta": 1e-9}, "print_every": 100
  },
  "tuning": {
    "objective": "field_plus_parameter_relative_error", "trials": 50, "epochs": 4000,
    "training_points": 1000, "sensor_points": 100, "validation_points": 2000, "initial_points": 100,
    "scheduler": {"factor": 0.8, "patience": 50, "min_learning_rate": 0.00001},
    "early_stopping": {"patience": 500, "min_delta": 1e-9},
    "n_basis": {"min": 10, "max": 90}, "degree": {"min": 2, "max": 6}
  },
  "output": {"tuned_hyperparameters": "bspline_hyper_tuned.json", "postprocessing_directory": "postprocessing", "show_plots": true}
}
